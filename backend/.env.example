# Copy this file to `.env` in the backend/ directory and adjust as needed.

# --- General ---
APP_NAME=AI Communication Coach
ENVIRONMENT=development
DEBUG=true

# --- Database ---
# Leave unset to use the default absolute path (backend/data/app.db),
# which works no matter what directory you launch the server from.
# Uncomment to override:
# DATABASE_URL=sqlite:////absolute/path/to/app.db

# --- Auth / JWT ---
# IMPORTANT: change this to a long, random string in production.
SECRET_KEY=dev-secret-key-change-this-in-production-please
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# --- CORS ---
# Comma-separated list of allowed frontend origins.
FRONTEND_ORIGINS=http://localhost:5173,http://localhost:3000

# --- File storage ---
UPLOAD_DIR=uploads

# --- Whisper / Speech-to-text ---
WHISPER_MODEL_SIZE=tiny
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8

# --- language_tool_python ---
LANGUAGE_TOOL_LANG=en-US
